@model StudentsModel

@{
    ViewData["Title"] = "Student Info";
}

<div class="w-full">
    <section class="w-full">
        <h1 class="text-[30px] font-bold text-[#001C37] mb-1">Full Student Info Report</h1>

        <div class="flex justify-between items-center">
            <p class="text-[#43474F] font-normal text-[15px] w-full">
                Client number / File number : 6732813908397
            </p>
        </div>
    </section>

    <section class="bg-white mt-10 border border-gray-400 rounded-2xl p-4 w-full">

        <div class="relative bg-[#F8F9FF] mt-5 border border-gray-400 rounded-2xl p-4 pt-10 w-full">

           
            <div class="absolute -top-6 left-4 flex items-center text-white">
                <div class="relative z-10 flex items-center justify-center w-12 h-12 rounded-full
                    bg-[#0B1C30] border-2 border-white">
                    <i class="fa-solid fa-eye text-xs"></i>
                </div>
                <div
                    class="-ml-5 pl-7 pr-5 py-1 bg-[#0B1C30] font-bold rounded-lg border-2 border-white whitespace-nowrap">
                    Practitioner Information
                </div>
            </div>

            @if (@Model?.AssignedPractitionerInfo == null)
            {
                <div class="mt-7">
                    <span class="text-red-500 font-semibold">
                        No Practitioner Assiged.
                    </span>
                </div>
            }
            else
            {
                <div class="mt-4">
                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Assigned Practitioner :</span>
                        <span class="text-gray-500">
                            @Model?.AssignedPractitionerInfo?.Title @Model?.AssignedPractitionerInfo?.FullName
                        </span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Personnel Number :</span>
                        <span class="text-gray-500">@Model?.AssignedPractitionerInfo?.PersonnelNumber</span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Role :</span>
                        <span class="text-gray-500">@Model?.AssignedPractitionerInfo?.Role</span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Gender :</span>
                        <span class="text-gray-500">@Model?.AssignedPractitionerInfo?.Gender</span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Email Address :</span>
                        <span class="text-gray-500">@Model?.AssignedPractitionerInfo?.Email</span>
                    </div>
            
                </div>
            }
            

        </div>


        @* Grid section *@
        <div class="grid grid-cols-2 gap-4 mt-10">

            @* 1 *@
            <div class="relative bg-[#F8F9FF] mt-5 border border-gray-400 rounded-2xl p-4 pt-10 w-full">

           
                <div class="absolute -top-6 left-4 flex items-center text-white">
                    <div class="relative z-10 flex items-center justify-center w-12 h-12 rounded-full
                        bg-[#421e6a] border-2 border-white">
                        <i class="fa-solid fa-user text-md"></i>
                    </div>
                    <div
                        class="-ml-5 pl-7 pr-5 py-1 bg-[#421e6a] font-bold rounded-lg border-2 border-white whitespace-nowrap">
                        1. Personal Information
                    </div>
                </div>

                <div class="mt-4">
                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Student Number :</span>
                        <span class="text-gray-500">@Model.StudentNumber</span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Surname :</span>
                        <span class="text-gray-500">@Model.Surname</span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Fist Name :</span>
                        <span class="text-gray-500">@Model.FirstName</span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Prefferd Name :</span>
                        <span class="text-gray-500">@Model.PreferredName</span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Date of Birth :</span>
                        <span class="text-gray-500">@Model.DateOfBirth.ToString("dd MMM yyyy")</span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Age :</span>
                        <span class="text-gray-500">@Model.Age</span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Gender :</span>
                        <span class="text-gray-500">@Model.Gender</span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">ID / Passport Number :</span>
                        <span class="text-gray-500">@Model.IdOrPassportNumber</span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Nationality :</span>
                        <span class="text-gray-500">@Model.Nationality</span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Home Language :</span>
                        <span class="text-gray-500">@Model.HomeLanguage</span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Other Language(s) :</span>
                        @{
                            var otherLangs = Model.OtherLanguages is { Length: > 0 }
                                ? string.Join(", ", Model.OtherLanguages)
                                : "None";
                        }
                        <span class="text-gray-500">@otherLangs</span>
                    </div>
            
                </div>

            

            </div>

            @* 2 *@
            <div class="relative bg-[#F8F9FF] mt-5 border border-gray-400 rounded-2xl p-4 pt-10 w-full">

           
                <div class="absolute -top-6 left-4 flex items-center text-white">
                    <div class="relative z-10 flex items-center justify-center w-12 h-12 rounded-full
                        bg-[#ED8C37] border-2 border-white">
                        <i class="fa-solid fa-people-roof text-md"></i>
                    </div>
                    <div
                        class="-ml-5 pl-7 pr-5 py-1 bg-[#ED8C37] font-bold rounded-lg border-2 border-white whitespace-nowrap">
                        2. Next of Kin / Emergency Contact
                    </div>
                </div>

                <div class="mt-4">
                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Full Name :</span>
                        <span class="text-gray-500">@Model.ContactPerson?.FullName</span>
                    </div>


                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Relationship :</span>
                        <span class="text-gray-500">@Model.ContactPerson?.Relationship</span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Cellphone Number :</span>
                        <span class="text-gray-500">@Model.ContactPerson?.CellphoneNumber</span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Alternate Number :</span>
                        <span class="text-gray-500">@Model.ContactPerson?.AlternateNumber</span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Email Address :</span>
                        <span class="text-gray-500">@Model.ContactPerson?.EmailAddress</span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Residential Address :</span>
                        <span class="text-gray-500">@Model.ContactPerson?.ResidentialAddress</span>
                    </div>
            
                </div>

            

            </div>

            @* 3 *@
            <div class="relative bg-[#F8F9FF] mt-5 border border-gray-400 rounded-2xl p-4 pt-10 w-full">

           
                <div class="absolute -top-6 left-4 flex items-center text-white">
                    <div class="relative z-10 flex items-center justify-center w-12 h-12 rounded-full
                        bg-[#2F6E1C] border-2 border-white">
                        <i class="fa-solid fa-graduation-cap text-md"></i>
                    </div>
                    <div
                        class="-ml-5 pl-7 pr-5 py-1 bg-[#2F6E1C] font-bold rounded-lg border-2 border-white whitespace-nowrap">
                        3. Academic Information
                    </div>
                </div>

                <div class="mt-4">
                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Faculty :</span>
                        <span class="text-gray-500">@Model.AcademicInfo?.Faculty</span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Department :</span>
                        <span class="text-gray-500">@Model.AcademicInfo?.Department</span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Qualification :</span>
                        <span class="text-gray-500">@Model.AcademicInfo?.Qualification</span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Year of study :</span>
                        <span class="text-gray-500">@Model.AcademicInfo?.YearOfStudy</span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Mode of Study :</span>
                        <span class="text-gray-500">@Model.AcademicInfo?.ModeOfStudy</span>
                    </div>

                    <div class="mt-2">
                        <span class="text-[#0B1C30] font-bold">Campus :</span>
                        <span class="text-gray-500">@Model.AcademicInfo?.Campus</span>
                    </div>
            
                </div>

            

            </div>

            @* 4 *@
            <div class="relative bg-[#F8F9FF] mt-5 border border-gray-400 rounded-2xl p-4 pt-10 w-full">

           
                <div class="absolute -top-6 left-4 flex items-center text-white">
                    <div class="relative z-10 flex items-center justify-center w-12 h-12 rounded-full
                        bg-[#1C366E] border-2 border-white">
                        <i class="fa-solid fa-house text-md"></i>
                    </div>
                    <div
                        class="-ml-5 pl-7 pr-5 py-1 bg-[#1C366E] font-bold rounded-lg border-2 border-white whitespace-nowrap">
                        4. Residence Information
                    </div>
                </div>

                <div class="mt-4">
                    <div class="mt-4">
                        <span class="text-[#0B1C30] font-bold">Residence Type :</span>
                        <span class="text-gray-500">@Model.ResidenceInfo?.ResidenceType</span>
                    </div>

                    @if (@Model.ResidenceInfo?.ResidenceType == "cut")
                    {
                        <div class="mt-2">
                            <span class="text-[#0B1C30] font-bold">Residence Name :</span>
                            <span class="text-gray-500">@Model.ResidenceInfo?.ResidenceName</span>
                        </div>

                        <div class="mt-2 ">
                            <span class="text-[#0B1C30] font-bold">Room Number :</span>
                            <span class="text-gray-500">@Model.ResidenceInfo?.RoomNumber</span>
                        </div>
                    }
                    else
                    {
                    

                        <div class="mt-2">
                            <span class="text-[#0B1C30] font-bold">Address :</span>
                            <span class="text-gray-500">@Model.ResidenceInfo?.PrivateAddress</span>
                        </div>

                        <div class="mt-2">
                            <span class="text-[#0B1C30] font-bold">City :</span>
                            <span class="text-gray-500">@Model.ResidenceInfo?.City</span>
                        </div>

                        <div class="mt-2">
                            <span class="text-[#0B1C30] font-bold">Postal Code :</span>
                            <span class="text-gray-500">@Model.ResidenceInfo?.PostalCode</span>
                        </div>

                        <div class="mt-2">
                            <span class="text-[#0B1C30] font-bold">Province :</span>
                            <span class="text-gray-500">@Model.ResidenceInfo?.Province</span>
                        </div>
                    }
                </div>

            

            </div>
        
        </div>

    </section>


</div>