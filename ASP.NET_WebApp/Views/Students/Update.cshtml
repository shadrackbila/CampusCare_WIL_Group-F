@using StudentManagement.Models
@model StudentsModel

@{
    ViewData["Title"] = "Update Practitioner";
}

<div class="w-full mt-14 flex justify-center items-center">
    <div
        class="bg-white border border-gray-400 rounded-2xl mx-2 py-8 px-3 items-center justify-center flex flex-col gap-8  w-full md:w-[75%] lg:w-[40%] max-w-2xl">

      

        <div class="w-full flex items-center justify-center gap-4">
    
               
            <form asp-controller="@ViewContext.RouteData.Values["controller"]" asp-action="Update" method="post"
                  class="w-full">

                <div class="flex flex-col gap-1 mt-4">
                    <label class="font-bold text-[17px] text-[#01305C]" asp-for="StudentNumber">Student Number</label>
                    <span asp-validation-for="StudentNumber" class="text-red-600 text-sm"></span>
                    <input asp-for="StudentNumber" class="border border-gray-400 rounded-lg bg-[#F8F9FF] h-10 px-3"
                           type="text">
                </div>

                <div class="flex flex-col gap-1 mt-4">
                    <label class="font-bold text-[17px] text-[#01305C]" asp-for="FirstName">First Name</label>
                    <span asp-validation-for="FirstName" class="text-red-600 text-sm"></span>
                    <input asp-for="FirstName" class="border border-gray-400 rounded-lg bg-[#F8F9FF] h-10 px-3"
                           type="text">
                </div>

                <div class="flex flex-col gap-1 mt-4">
                    <label class="font-bold text-[17px] text-[#01305C]" asp-for="Surname">Surname</label>
                    <span asp-validation-for="Surname" class="text-red-600 text-sm"></span>
                    <input asp-for="Surname" class="border border-gray-400 rounded-lg bg-[#F8F9FF] h-10 px-3"
                           type="text">
                </div>

                <div class="flex flex-col gap-1 mt-4">
                    <label class="font-bold text-[17px] text-[#01305C]" asp-for="PreferredName">Preffered Name</label>
                    <span asp-validation-for="PreferredName" class="text-red-600 text-sm"></span>
                    <input asp-for="PreferredName" class="border border-gray-400 rounded-lg bg-[#F8F9FF] h-10 px-3"
                           type="text">
                </div>

                <div class="flex flex-col gap-1 mt-4">
                    <label class="font-bold text-[17px] text-[#01305C]" asp-for="DateOfBirth">Date of birth</label>
                    <span asp-validation-for="DateOfBirth" class="text-red-600 text-sm"></span>
                    <input asp-for="DateOfBirth" class="border border-gray-400 rounded-lg bg-[#F8F9FF] h-10 px-3"
                           type="date">
                </div>

                <div class="flex flex-col gap-1 mt-4">
                    <label class="font-bold text-[17px] text-[#01305C]" asp-for="Gender">Gender</label>
                    <span asp-validation-for="Gender" class="text-red-600 text-sm"></span>
                    <select asp-for="Gender" class="border border-gray-400 rounded-lg bg-[#F8F9FF] h-10 px-3">
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="other">Prefer not to say</option>
                    </select>
                </div>

                <div class="flex flex-col gap-1 mt-4">
                    <label class="font-bold text-[17px] text-[#01305C]" asp-for="AssignedPractitionerID">Assigned
                        Practitioner</label>
                        <span asp-validation-for="AssignedPractitionerID" class="text-red-600 text-sm"></span>
                        <select asp-for="AssignedPractitionerID"
                                class="border border-gray-400 rounded-lg bg-[#F8F9FF] h-10 px-3">

                            @foreach (var practitioner in (List<PractitionerModel>)ViewBag.Practitioners)
                            {
                                <option value="@practitioner.ID">@practitioner.Title @practitioner.FullName</option>
                            }
                        </select>
                    </div>

    

                
                    @* <div class="flex flex-col gap-1 mt-4">
                    <label class="font-bold text-[17px] text-[#01305C]" asp-for="Title">Title</label>
                    <span asp-validation-for="Title" class="text-red-600 text-sm"></span>
                    <select asp-for="Title" class="border border-gray-400 rounded-lg bg-[#F8F9FF] h-10 px-3">
                        <option value="Mr.">Mr.</option>
                        <option value="Mrs">Mrs.</option>
                        <option value="Ms.">Ms.</option>
                        <option value="Dr.">Dr.</option>
                    </select>
                </div> *@
                    @* 
                <div class="flex flex-col gap-1 mt-4">
                    <label class="font-bold text-[17px] text-[#01305C]" asp-for="Email">Email</label>
                    <span asp-validation-for="Email" class="text-red-600 text-sm"></span>
                    <input asp-for="Email"
                           class="border opacity-50 cursor-not-allowed border-gray-400 rounded-lg bg-[#F8F9FF] h-10 px-3"
                           type="email" disabled>
                    <input asp-for="Email" type="hidden" />
                </div>

                <div class="flex flex-col gap-1 mt-4">
                    <label class="font-bold text-[17px] text-[#01305C]" asp-for="PersonnelNumber">Personnel
                        Number</label>
                        <span asp-validation-for="PersonnelNumber" class="text-red-600 text-sm"></span>
                        <input asp-for="PersonnelNumber" class="border border-gray-400 rounded-lg bg-[#F8F9FF] h-10 px-3"
                               type="text">
                    </div> *@

                    <div class="w-full flex justify-center items-center gap-4 mt-8">
                        <a asp-action="Index"
                           class="text-white w-full bg-[#C5C5C5] flex items-center justify-center py-1.5 rounded-lg">Cancel</a>

                        <button type="submit"
                                class="text-white w-full bg-[#007BB9] hover:bg-[#005f8f] duration-300 transition-colors flex items-center justify-center py-1.5 rounded-lg">
                            Update
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>