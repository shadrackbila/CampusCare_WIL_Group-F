<div
    class="fixed inset-x-0 bottom-0 top-16 bg-[#6F7180]/50 backdrop-blur-md z-50 overflow-hidden flex justify-center items-center">
    <div
        class="bg-white border border-gray-400 rounded-2xl mx-2 py-8 px-3 items-center justify-center flex flex-col gap-8  w-full md:w-[75%] lg:w-[40%] max-w-2xl">

        <p class="w-full md:w-[50%] text-center text-[17px] font-semibold text-gray-700">Are you sure you want to delete
            <span>@ViewBag.type</span>
        </p>

        <div class="w-full flex items-center justify-center gap-4">
            <a class="text-white w-full bg-[#C5C5C5] flex items-center justify-center py-1.5 rounded-lg"
               href="@Context.Request.Headers["Referer"]">Cancel</a>
               
            <form asp-controller="@ViewContext.RouteData.Values["controller"]" asp-action="Delete"
                  asp-route-id="@ViewContext.RouteData.Values["id"]" method="post" class="w-full">
                <button type="submit"
                        class="text-white w-full bg-[#BA7070] flex items-center justify-center py-1.5 rounded-lg">
                    Delete
                </button>
            </form>
        </div>
    </div>
</div>