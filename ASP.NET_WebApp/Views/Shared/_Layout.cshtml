<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ASP.NET_WebApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ASP.NET_WebApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
</head>

<body class="bg-[#F8F9FF] flex justify-center items-center flex-col relative ">
    <header class=" w-full sticky top-0 z-10">
        <nav
            class="w-full navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow  ">

            <div class="ml-10 w-full">
                <button id="openBtn" onclick="sideBar(true)">
                    <i class="fa-solid fa-bars"></i>
                </button>

                <button id="closeBtn" class="hidden" onclick="sideBar(false)">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="w-full flex justify-end items-center px-4 py-2">
                <div class="flex justify-center items-center gap-4">

                    <div>
                        <i class="fa-regular fa-bell text-lg"></i>
                    </div>
                    <div class="flex justify-center items-center gap-2">
                   
                        <i class="fa-solid fa-circle-user  text-3xl "></i>
                        
                        <div>
                            <div class="text-[13px] font-semibold text-[#001C37]">Adam Smith</div>
                            <div class="text-[11px] font-semibold text-[#43474F]">Administrator</div>
                        </div>
                      
                        <i class="fa-solid fa-chevron-down text-[12px] text-[#43474F]"></i>
                      
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="w-full  flex  ">
        @* ------------------------------ *@
        @* Side bar *@
        @* ------------------------------ *@
        <div id="sidebar"
             class="bg-[#001E40] w-64 sticky top-[var(--header-h,64px)] self-start h-[calc(100vh-64px)] shrink-0 hidden">
            yabababababab
        </div>

        @* ------------------------------ *@
        @* Content *@
        @* ------------------------------ *@
        <div class="w-full max-w-7xl mx-auto">
            <main role="main" class="pb-3 m-4">
                @RenderBody()
            </main>

            <footer class="w-full bg-slate-600">
                <div class="m-4 max-w-7xl">
                    @* &copy; 2026 - ASP.NET_WebApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> *@
                </div>
            </footer>
        </div>
   
    </div>

 
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/sideBar.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
