<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ASP.NET_WebApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ASP.NET_WebApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
</head>

<body class="bg-[#F8F9FF]">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="w-full flex justify-end items-center px-4 py-2">
                <div class="flex justify-center items-center gap-4">

                    <div>
                        <i class="fa-regular fa-bell text-lg"></i>
                    </div>
                    <div class="flex justify-center items-center gap-2">
                   
                        <i class="fa-solid fa-circle-user  text-3xl "></i>
                        
                        <div>
                            <div class="text-[13px] font-semibold text-[#001C37]">Adam Smith</div>
                            <div class="text-[11px] font-semibold text-[#43474F]">Administrator</div>
                        </div>
                      
                        <i class="fa-solid fa-chevron-down text-[12px] text-[#43474F]"></i>
                      
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="w-full">
        <main role="main" class="pb-3 m-4">
            @RenderBody()
        </main>
    </div>

    <footer class="w-full">
        <div class="m-4">
            &copy; 2026 - ASP.NET_WebApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
