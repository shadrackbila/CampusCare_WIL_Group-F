<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ASP.NET_WebApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ASP.NET_WebApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
</head>

<body class="bg-[#F8F9FF] flex justify-center items-center flex-col relative ">
    <header class=" w-full sticky top-0 z-50">
        <nav
            class="w-full navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow  ">

            <div class="ml-10 w-full">
                <button id="openBtn" class="hidden" onclick="sideBar(true)">
                    <i class="fa-solid fa-bars"></i>
                </button>

                <button id="closeBtn" onclick="sideBar(false)">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="w-full flex justify-end items-center px-4 py-2">
                <div class="flex justify-center items-center gap-4">

                
                    <div class="flex justify-center items-center gap-2">
                   
                        <i class="fa-solid fa-circle-user  text-3xl "></i>
                        
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var fullName = User.Identity?.Name ?? "";
                            var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";

                            <div>
                                <div class="text-[13px] font-semibold text-[#001C37]">@fullName</div>
                                <div class="text-[11px] font-semibold text-[#43474F]">@role</div>
                            </div>
                        }
                      
                      
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="w-full  flex  ">
        @* ------------------------------ *@
        @* Side bar *@
        @* ------------------------------ *@
        <div id="sidebar"
             class="bg-[#001E40] w-64 sticky top-[var(--header-h,64px)] self-start h-[calc(100vh-64px)] shrink-0  py-10 px-3">
            <div class="w-full bg-white">
                <img class="w-[50%]" src="~/assets/imgs/cut_logo.png" alt="Logo">
            </div>

            <div class="w-full ">
                <ul class="w-full flex flex-col items-start justify-center  mt-10 text-white">


                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";

                        var DashAction = role;

                        switch (DashAction)
                        {
                            case "admin":
                                DashAction = "Index";
                                break;

                            case "practitioner":
                                DashAction = "Practitioners";
                                break;

                            case "peer_educator":
                                DashAction = "PeerEducators";
                                break;

                            default:
                                break;
                        }

                        <a asp-controller="Home" asp-action="@DashAction" class="hover:bg-[#007BB9] w-full my-1 rounded-lg">
                            <li class="w-full flex justify-start items-center gap-2 my-2 pl-3">
                                <i class="fa-solid fa-table-cells-large text-2xl "></i>
                                <p class="text-base">Dashboard</p>
                            </li>
                        </a>

                        @if (role == "practitioner")
                        {
                            <a class="hover:bg-[#007BB9] w-full my-1 rounded-lg" asp-controller="Appointments"
                               asp-action="AppointmentsForPract">
                                <li class="w-full flex justify-start items-center gap-2 my-2 pl-3">
                                    <i class="fa-solid fa-calendar-check text-2xl w-8 text-center"></i>
                                    <p class="text-base">Appointment</p>
                                </li>
                            </a>
                        }

                        @if (role == "admin")
                        {
                            <a class="hover:bg-[#007BB9] w-full my-1 rounded-lg" asp-controller="Practitioners"
                               asp-action="Index">
                                <li class="w-full flex justify-start items-center gap-2 my-2 pl-3">
                                    <i class="fa-solid fa-user-doctor text-2xl w-8 text-center"></i>
                                    <p class="text-base">Practitioners</p>
                                </li>
                            </a>

                            <a class="hover:bg-[#007BB9] w-full my-1 rounded-lg" asp-controller="Appointments"
                               asp-action="Index">
                                <li class="w-full flex justify-start items-center gap-2 my-2 pl-3">
                                    <i class="fa-solid fa-calendar-check text-2xl w-8 text-center"></i>
                                    <p class="text-base">Appointment</p>
                                </li>
                            </a>

                            <a class="hover:bg-[#007BB9] w-full my-1 rounded-lg" asp-controller="Students" asp-action="Index">
                                <li class="w-full flex justify-start items-center gap-2 my-2 pl-3">
                                    <i class="fa-solid fa-user-graduate text-2xl w-8 text-center"></i>
                                    <p class="text-base">Students</p>
                                </li>
                            </a>
                        }
                    }


                </ul>

                <div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="w-full my-1">
                        <button type="submit"
                                class="hover:bg-[#007BB9] text-white w-full rounded-lg text-left  border-0 cursor-pointer">
                            <div class="w-full flex justify-start items-center gap-2 my-2 pl-3">
                                <i class="fa-solid fa-right-from-bracket text-2xl w-8 text-center"></i>
                                <p class="text-base">Sign Out</p>
                            </div>
                        </button>
                    </form>
                </div>
            </div>
        </div>

        @* ------------------------------ *@
        @* Content *@
        @* ------------------------------ *@
        <div class="w-full max-w-7xl mx-auto">
            <main role="main" class="pb-3 m-4">
                @RenderBody()
            </main>

            <footer class="w-full bg-slate-600">
                <div class="m-4 max-w-7xl">
                    @* &copy; 2026 - ASP.NET_WebApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> *@
                </div>
            </footer>
        </div>
   
    </div>

 
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/sideBar.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
