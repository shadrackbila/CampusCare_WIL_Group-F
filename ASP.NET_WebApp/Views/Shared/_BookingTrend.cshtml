@using System.Globalization
@model IEnumerable<DateTime>

@{
    const int days = 7;
    const double left = 35, right = 420, top = 30, bottom = 200;

    var dates = Enumerable.Range(0, days).Select(i => DateTime.Today.AddDays(i - (days - 1))).ToList();
    var all = (Model ?? Enumerable.Empty<DateTime>()).Select(d => d.Date).ToList();
    var counts = dates.Select(d => all.Count(x => x == d)).ToList();

    // Y axis: 4 steps, top is a multiple of 4
    var yMax = Math.Max(4, (int)Math.Ceiling(counts.Max() / 4.0) * 4);

    string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    double X(int i) => left + i * (right - left) / (days - 1);
    double Y(double v) => bottom - v / yMax * (bottom - top);

    var pts = counts.Select((c, i) => (x: X(i), y: Y(c))).ToList();

    // Smooth curve through the points
    var line = $"M {F(pts[0].x)} {F(pts[0].y)}";
    for (var i = 0; i < pts.Count - 1; i++)
    {
        var p0 = pts[Math.Max(i - 1, 0)];
        var p1 = pts[i];
        var p2 = pts[i + 1];
        var p3 = pts[Math.Min(i + 2, pts.Count - 1)];

        var c1y = Math.Clamp(p1.y + (p2.y - p0.y) / 6, top, bottom);
        var c2y = Math.Clamp(p2.y - (p3.y - p1.y) / 6, top, bottom);

        line += $" C {F(p1.x + (p2.x - p0.x) / 6)} {F(c1y)}, {F(p2.x - (p3.x - p1.x) / 6)} {F(c2y)}, {F(p2.x)} {F(p2.y)}";
    }
    var area = $"{line} L {F(right)} {F(bottom)} L {F(left)} {F(bottom)} Z";

    var last = pts[^1];
}

<svg viewBox="0 0 440 240" class="w-full h-auto" font-family="inherit">
    <defs>
        <linearGradient id="trendFill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#00346B" stop-opacity="0.15" />
            <stop offset="100%" stop-color="#00346B" stop-opacity="0" />
        </linearGradient>
    </defs>

    <!-- Grid lines and Y labels -->
    @for (var s = 0; s <= 4; s++)
    {
        var v = yMax / 4 * s;
        <line x1="@F(left)" x2="@F(right)" y1="@F(Y(v))" y2="@F(Y(v))" stroke="#CBD5E1" stroke-width="1"
              stroke-dasharray="@(s == 0 ? "0" : "4 4")" opacity="@(s == 0 ? "1" : "0.6")" />
        @:<text x="0" y="@F(Y(v) + 4)" font-size="12" fill="#94A3B8">@v</text>
    }

    <!-- Area and line -->
    <path d="@area" fill="url(#trendFill)" />
    <path d="@line" fill="none" stroke="#00346B" stroke-width="2.5" stroke-linecap="round" />

    <!-- Points -->
    @for (var i = 0; i < pts.Count; i++)
    {
        var isLast = i == pts.Count - 1;
        <circle cx="@F(pts[i].x)" cy="@F(pts[i].y)" r="@(isLast ? "4.5" : "4")" fill="@(isLast ? "#00346B" : "white")"
                stroke="#00346B" stroke-width="2" />
    }

    <!-- Value label on the latest point -->
    <rect x="@F(last.x - 18)" y="@F(last.y - 36)" width="36" height="24" rx="6" fill="#001C37" />
    <text x="@F(last.x)" y="@F(last.y - 20)" font-size="13" font-weight="700" fill="white"
          text-anchor="middle">@counts[^1]</text>

    <!-- X labels -->
    @for (var i = 0; i < dates.Count; i++)
    {
        var isLast = i == dates.Count - 1;
        var weight = isLast ? "700" : "600";
        var color = isLast ? "#00346B" : "#475569";
        var label = dates[i].ToString("d MMM", CultureInfo.InvariantCulture);

        @:<text x="@F(X(i))" y="225" font-size="11" text-anchor="middle" font-weight="@weight" fill="@color">@label</text>
    }
</svg>