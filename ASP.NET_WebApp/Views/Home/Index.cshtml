@{
ViewData["Title"] = "Home Page";
}

<div class="w-full">
    <section class="w-full">
        <h1 class="text-[30px] font-bold text-[#001C37] mb-1">Reports & Analytics</h1>

        <div class="flex justify-between items-center">
            <div class="w-full">
                <p class="text-[#43474F] font-normal text-[15px] w-full md:w-[35%]">View system reports and key
                    analytics
                    insights.</p>
            </div>

            <div class="w-full flex justify-end items-center">
                <div
                    class="flex justify-center items-center gap-2 bg-white py-2 px-4 rounded-2xl border border-gray-400">

                    <i class="fa-regular fa-calendar text-[#001C37] text-xl"></i>

                    <p class="text-[#001C37] font-semibold text-[15px]">15 Aug 2025 - 21 Sep 2025</p>

                    <i class="fa-solid fa-chevron-down text-[12px] text-[#43474F]"></i>

                </div>
            </div>
        </div>

    </section>

    <!-- Stats -->
    <section class="w-full mt-10">
        <div class="grid grid-cols-4">

            <div class="flex justify-center items-center p-4 rounded-2xl bg-white border border-gray-400 gap-2">
                <img src="" alt="">
                <div>
                    <p class="text-[#001C37] text-[24px] font-bold">1234</p>
                    <p class="text-[#43474F] ">Total students</p>
                </div>
            </div>


            <div></div>
            <div></div>
            <div></div>

        </div>
    </section>

</div>