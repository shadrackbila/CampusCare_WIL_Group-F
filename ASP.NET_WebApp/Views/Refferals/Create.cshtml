@model RefferalsModel

@{
    ViewData["Title"] = "Reffer Student";
}

<div class="w-full mt-14 flex justify-center items-center">
    <div
        class="bg-white border border-gray-400 rounded-2xl mx-2 py-8 px-3 items-center justify-center flex flex-col gap-8  w-full md:w-[75%] lg:w-[40%] max-w-2xl">

      

        <div class="w-full flex items-center justify-center gap-4">
    
               
            <form asp-controller="@ViewContext.RouteData.Values["controller"]" asp-action="Create" method="post"
                  class="w-full">

                <div asp-validation-summary="All" class="text-red-600"></div>
    
           

                <div class="flex flex-col gap-1 mt-4">
                    <label class="font-bold text-[17px] text-[#01305C]" asp-for="SupportReason">Support Reason</label>
                    <span asp-validation-for="SupportReason" class="text-red-600 text-sm"></span>
                    <input asp-for="SupportReason" class="border border-gray-400 rounded-lg bg-[#F8F9FF] h-10 px-3"
                           type="text">
                </div>

                <input type="hidden" asp-for="StudentID" />
    
                <div class="w-full flex justify-center items-center gap-4 mt-8">
                    <a asp-action="Index"
                       class="text-white w-full bg-[#C5C5C5] flex items-center justify-center py-1.5 rounded-lg">Cancel</a>

                    <button type="submit"
                            class="text-white w-full bg-[#007BB9] hover:bg-[#005f8f] duration-300 transition-colors flex items-center justify-center py-1.5 rounded-lg">
                        Update
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>