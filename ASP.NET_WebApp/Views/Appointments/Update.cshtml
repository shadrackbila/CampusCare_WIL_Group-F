@model AppointmentsModel

@{
    ViewData["Title"] = "Update Practitioner";
}

<div class="w-full mt-14 flex justify-center items-center">
    <div
        class="bg-white border border-gray-400 rounded-2xl mx-2 py-8 px-3 items-center justify-center flex flex-col gap-8  w-full md:w-[75%] lg:w-[40%] max-w-2xl">

      

        <div class="w-full flex items-center justify-center gap-4">
    
               
            <form asp-controller="@ViewContext.RouteData.Values["controller"]" asp-action="Update" method="post"
                  class="w-full">

                <div asp-validation-summary="All" class="text-red-600"></div>
                <div class="flex flex-col gap-1 mt-4">
                    <label class="font-bold text-[17px] text-[#01305C]" asp-for="AppointmentDate">Appointment
                        Date</label>
                        <span asp-validation-for="AppointmentDate" class="text-red-600 text-sm"></span>
                        <input asp-for="AppointmentDate" class="border border-gray-400 rounded-lg bg-[#F8F9FF] h-10 px-3"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" type="date">
                    </div>

                    <div class="flex flex-col gap-1 mt-4">
                        <label class="font-bold text-[17px] text-[#01305C]" asp-for="AppointmentTime">Appoointment
                            Time</label>
                            <span asp-validation-for="AppointmentTime" class="text-red-600 text-sm"></span>
                            <input asp-for="AppointmentTime" class="border border-gray-400 rounded-lg bg-[#F8F9FF] h-10 px-3"
                                   min="08:00" max="15:59" type="time">
                        </div>

           

                        <div class="flex flex-col gap-1 mt-4">
                            <label class="font-bold text-[17px] text-[#01305C]" asp-for="Status">Status</label>
                            <span asp-validation-for="Status" class="text-red-600 text-sm"></span>
                            <select asp-for="Status" class="border border-gray-400 rounded-lg bg-[#F8F9FF] h-10 px-3">
                                <option value="default"></option>
                                <option value="confirmed">Confirm Booking.</option>
                                <option value="completed">Session Completed.</option>
                                <option value="no_show">Student didnt come.</option>
                                <option value="cancelled">Cancel appointment.</option>
                            </select>
                        </div>

                        <div class="flex flex-col gap-1 mt-4">
                            <label class="font-bold text-[17px] text-[#01305C]"
                                   asp-for="Student.AssignedPractitionerID">Assigned
                                Practitioner</label>
                                <span asp-validation-for="Student.AssignedPractitionerID" class="text-red-600 text-sm"></span>
                                <select asp-for="Student.AssignedPractitionerID"
                                        class="border border-gray-400 rounded-lg bg-[#F8F9FF] h-10 px-3">

                                    @foreach (var practitioner in ViewBag.Practitioners)
                                    {
                                        <option value="@practitioner.ID">@practitioner.Title @practitioner.FullName</option>
                                    }
                                </select>
                            </div>

    
                            <div class="w-full flex justify-center items-center gap-4 mt-8">
                                <a asp-action="Index"
                                   class="text-white w-full bg-[#C5C5C5] flex items-center justify-center py-1.5 rounded-lg">Cancel</a>

                                <button type="submit"
                                        class="text-white w-full bg-[#007BB9] hover:bg-[#005f8f] duration-300 transition-colors flex items-center justify-center py-1.5 rounded-lg">
                                    Update
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>