@model List<AppointmentsModel>

@{
    ViewData["Title"] = "Appointments";
}

<div class="w-full">
    <section class="w-full">
        <h1 class="text-[30px] font-bold text-[#001C37] mb-1">Appointments</h1>

        <div class="flex justify-between items-center">
            <p class="text-[#43474F] font-normal text-[15px] w-full lg:w-[50%]">
                Search appointments, check their status and keep schedules up to date.
            </p>
        </div>
    </section>

    <section class="bg-white border border-gray-400 w-full mt-10 p-4 rounded-2xl overflow-x-auto">
        <table class="w-full min-w-[640px] text-left text-sm">
            <thead class="bg-gray-50 text-[#43474F]  border-y border-gray-400">
                <tr class="uppercase">
                    <th class="px-4 py-3 font-semibold">Student</th>
                    <th class="px-4 py-3 font-semibold">Student number</th>
                    <th class="px-4 py-3 font-semibold">Assigned Practitioner</th>
                    <th class="px-4 py-3 font-semibold">Scheduled Date</th>
                    <th class="px-4 py-3 font-semibold">Type</th>
                    <th class="px-4 py-3 font-semibold">Status</th>
                    <th class="px-4 py-3 font-semibold text-center">Manage</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
                @if (Model == null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="px-4 py-6 text-center text-gray-500">No Appointments found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var appointment in Model)
                    {
                        <tr class="group cursor-pointer hover:bg-[#CFD4E0] transition-colors duration-200"
                            data-href="@Url.Action("GetStudent", "Students", new { id = @appointment?.Student?.id })">
                            <td class="px-4 py-3">@appointment?.Student?.FirstName @appointment?.Student?.Surname</td>
                            <td class="px-4 py-3">@appointment?.Student?.StudentNumber</td>
                            <td class="px-4 py-3 whitespace-nowrap">
                                @if (@appointment?.Student?.AssignedPractitionerInfo == null)
                                {
                                    <span class="text-gray-500 font-medium">No Practitioner Assigned.</span>
                                }
                                else
                                {
                                    <span class="text-[#001E40] font-medium">@appointment?.Student?.AssignedPractitionerInfo?.Title
                                        @appointment?.Student?.AssignedPractitionerInfo?.FullName
                                    </span>
                                    <span class="text-gray-500">| @appointment?.Student?.AssignedPractitionerInfo?.Role</span>
                                }
                            </td>
                            <td class="px-4 py-3 whitespace-nowrap">
                                <span class="text-[#001E40] font-medium">@appointment?.AppointmentDate.ToString("dd MMM yyyy")</span>
                                <span class="text-gray-500">| @appointment?.AppointmentTime.ToString(@"hh\:mm")</span>
                            </td>
                            <td class="px-4 py-3">In-Person</td>
                            <td class="px-4 py-3">@appointment?.Status</td>
                            <td class="px-4 py-3">
                                <div class="row-actions flex justify-center items-center bg-white p-2 rounded-2xl gap-6">
                                    <a asp-action="Update" asp-controller="appointments" asp-route-id="@appointment?.ID"
                                       class="text-[#007BB9] hover:text-[#005f8f]" aria-label="Edit appointment">
                                        <i class="fa-solid fa-pen-to-square text-base"></i>
                                    </a>
                                    <a asp-action="ConfirmDelete" asp-controller="appointments" asp-route-id="@appointment?.ID"
                                       class="text-red-500 hover:text-red-700" aria-label="Delete appointment">
                                        <i class="fa-solid fa-trash text-base"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </section>
</div>